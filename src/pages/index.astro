---
import IndexLayout from '../layouts/IndexLayout.astro';
import Header from '../components/Header.astro';
import IndexCarousel from './Index/IndexCarousel.astro';
import IndexProducts from './Index/IndexProducts.astro';
import IndexServices from './Index/IndexServices.astro';
import IndexMap from './Index/IndexMap.astro';
import Footer from '../components/Footer.astro';
---

<IndexLayout title="Bakery">
	<Header />
	<main>
		<!---- Landing ---->
		<section class="landing-section">
			<h1 class="main-title">Our Bakery</h1>
			<h2 class="main-subtitle">Bread, Cakes & Delicacies</h2>
		</section>
		<IndexCarousel />
		<IndexProducts />
		<IndexServices />
		<IndexMap />
	</main>
	<Footer />
				
</IndexLayout>

