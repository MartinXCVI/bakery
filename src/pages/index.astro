---
import IndexLayout from '@layouts/IndexLayout.astro';
import Header from '@components/Header.astro';
import IndexCarousel from '@components/Index/IndexCarousel.astro';
import IndexProducts from '@components/Index/IndexProducts.astro';
import IndexServices from '@components/Index/IndexServices.astro';
import IndexMap from '@components/Index/IndexMap.astro';
import Footer from '@components/Footer.astro';

const title: string = "Our Bakery"
const subtitle: string = "Bread, Cakes & Delicacies"
---

<IndexLayout title="Bakery">
	<Header />
	<main>
		<script>
			import { setupScrollAnimations } from "../scripts/gsapAnimations";
			setupScrollAnimations();
		</script>
		<!---- Landing ---->
		<section class="landing-section">
			<h1 class="main-title">{title}</h1>
			<h2 class="main-subtitle">{subtitle}</h2>
		</section>
		<IndexCarousel />
		<IndexProducts />
		<IndexServices />
		<IndexMap />
	</main>
	<Footer />
</IndexLayout>

