---
import IndexCarouselCard from "./IndexCarouselCard.astro"
---

<section class="index-carousel-section">
  <section class="action-section">
    <h2 class="action-subtitle">You</h2>
    <h2 class="action-subtitle">Deserve</h2>
    <h2 class="action-subtitle">The Best of it All</h2>
    <section class="action-message-section">
      <p>Artisanal production with the best ingredients, effectiveness through simplicity, and most importantly, all of our love in what we do for our beloved people.</p>
      <a
        class="action-message-btn"
        href="/about"
        title="Button to About page"
      >
        More About Us
      </a>
    </section>
  </section>
  <section id="index-carousel-container">
    <div class="index-slider my-slider">
      <IndexCarouselCard
        src="/images/index-slider/is-1.jpg"
        alt=""
      />
