<section class="index-products-wrapper">
  <h2 class="index-products-title fade-down">Our Products</h2>
  <section class="index-products-section over-hidden">
    <article class="index-product-art slide-left-to-right">
      <figure>
        <img
          src="/icons/bread-coffee.png"
          alt="Bread and coffee icon"
          title="Bread and coffee icon"
        >
      </figure>
      <h3 class="index-products-subtitle">Bread & Coffee</h3>
      <p class="products-text">Start your morning right with our freshly baked artisan breads and expertly crafted coffee. From crusty sourdough to soft brioche, paired with rich espresso or smooth lattes, we bring warmth to every bite.</p>
      <a
        class="products-link"
        href="/Products#bread-section"
        target="_blank"
        rel="noreferrer noopener"
        title="See more..."
      >
        See more <i class="fa-solid fa-caret-right"></i>
      </a>
    </article>
    <article class="index-product-art fade-up">
      <figure>
        <img
          src="/icons/pastries.png"
          alt="Pastries icon"
          title="Pastries icon"
        >
      </figure>
      <h3 class="index-products-subtitle">Pastries & Delicacies</h3>
      <p class="products-text">Indulge in our handcrafted pastries made with premium ingredients and traditional techniques. Each flaky croissant, buttery danish, and delicate macaron is a testament to our passion for perfection and flavor.</p>
      <a
        class="products-link"
        href="/Products#pastries-section"
        target="_blank"
        rel="noreferrer noopener"
        title="See more..."
      >
        See more <i class="fa-solid fa-caret-right"></i>
      </a>
    </article>
    <article class="index-product-art slide-right-to-left">
      <figure>
        <img
          src="/icons/cake.png"
          alt="Cake icon"
          title="Cake icon"
        >
      </figure>
      <h3 class="index-products-subtitle">Cakes & Pies</h3>
      <p class="products-text">Celebrate life's special moments with our custom cakes and homemade pies. Whether it's a decadent chocolate layer cake or a classic apple pie, every slice delivers joy, made with love from our kitchen to yours.</p>
      <a
        class="products-link"
        href="/Products#cakes-section"
        target="_blank"
        rel="noreferrer noopener"
        title="See more..."
      >
        See more <i class="fa-solid fa-caret-right"></i>
      </a>
    </article>
  </section>
</section>