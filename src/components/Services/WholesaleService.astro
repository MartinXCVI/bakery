---
import WholesaleCard from "./WholesaleCard.astro"
---

<section class="lunch-section-wrapper" id="lunch-section">
  <article class="lunch-article-intro fade-up">
    <p class="lunch-intro">Whole Service</p>
    <figure class="product-fig">
      <img
        src="/icons/wholesale-icon.png"
        alt=""
        title=""
      >
    </figure>
    <h2 class="lunch-subtitle">Fresh Wholesale Bread with Quality at Bulk Prices</h2>
    <p class="lunch-text">
      We've developed a unique wholesale baking model, blending our family's artisanal baking tradition with medium to large-scale production and distribution.
    </p>
    <p class="lunch-text">
      Because we care as much about quality and attention to detail as you do, we can make a great team! We also develop custom products. Ask us.
    </p>
    <a
      class="services-btn"
      href="/Contact"
      title="Button to Contact page"
    >
      Ask for a quote
    </a>
  </article>
  <article class="wholesale-article">
    <WholesaleCard 
      src="/images/services/wholesale/arab-bread.webp"
      title="Arab bread"
      text="Soft, pillowy flatbread perfect for wraps, dips, and Mediterranean meals. Freshly baked with love."
    />
    <WholesaleCard 
      src="/images/services/wholesale/buttermilk-biscuits.webp"
      title="Buttermilk Biscuits"
      text="Flaky, buttery biscuits with a tender crumb. Ideal for breakfast, dinner sides, or enjoying with jam."
    />
    <WholesaleCard 
      src="/images/services/wholesale/challah-bread.webp"
      title="Challah Bread"
      text="Traditional braided bread with a rich, slightly sweet flavor. Perfect for French toast or sandwiches."
    />
    <WholesaleCard 
      src="/images/services/wholesale/croissants.webp"
      title="Croissants"
      text="Golden, flaky pastries with countless buttery layers. A classic that melts in your mouth daily."
    />
    <WholesaleCard 
      src="/images/services/wholesale/french-bread.webp"
      title="French bread"
      text="Crusty baguettes with a chewy interior and great taste. Perfect alongside soups & cheeses."
    />
    <WholesaleCard 
      src="/images/services/wholesale/sandwich-bread.webp"
      title="Sandwich Bread"
      text="Soft, sliceable loaves ideal for any sandwich creation. Made fresh daily for your lunchbox favorites."
    />
    <WholesaleCard 
      src="/images/services/wholesale/tortilla-bread.webp"
      title="Tortilla Bread"
      text="Thin, flexible flatbreads perfect for tacos, quesadillas, and wraps. Authentic flavor in every bite."
    />
    <WholesaleCard 
      src="/images/services/wholesale/varied-cookies.webp"
      title="Varied Cookies"
      text="An assortment of homemade cookies in different flavors. From chocolate chip to oatmeal!"
    />
  </article>
</section>