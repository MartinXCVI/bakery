---
import { myData } from "@data/myData"

const { phone, email, address } = myData
---

<section class="contact-info-section fade-up">
  <div class="contact-item">
    <div class="contact-icon">
      <i class="fa-solid fa-phone fa-icon"></i>
    </div>
    <div class="contact-info">
      <h3>Call us</h3>
      <a href="tel:123456789">{phone}</a>
    </div>
  </div>
  <div class="contact-item">
    <div class="contact-icon">
      <i class="fa-solid fa-envelope fa-icon"></i>
    </div>
    <div class="contact-info">
      <h3>Email us</h3>
      <a href="mailto:bakery@gmail.com">{email}</a>
    </div>
  </div>
  <div class="contact-item">
    <div class="contact-icon">
      <i class="fa-solid fa-location-dot fa-icon"></i>
    </div>
    <div class="contact-info">
      <h3>Visit us</h3>
      <p>{address}</p>
    </div>
  </div>
</section>