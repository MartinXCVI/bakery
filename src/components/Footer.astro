---
import { myData } from "@data/myData"

const { name, phone, email, address, hourlies, facebook, instagram, youtube } = myData
---

<footer class="footer">
  <section class="footer-contact-section fade-down">
    <div class="footer-contact-card">
      <div class="contact-icon">
        <i class="fa-solid fa-phone fa-icon"></i>
      </div>
      <div class="contact-info">
        <h3>Call Us</h3>
        <a href="tel:123456789">{phone}</a>
      </div>
    </div>
    <div class="footer-contact-card">
      <div class="contact-icon">
        <i class="fa-solid fa-envelope fa-icon"></i>
      </div>
      <div class="contact-info">
        <h3>Email us</h3>
        <a href="mailto:bakery@gmail.com">{email}</a>
      </div>
    </div>
    <div class="footer-contact-card">
      <div class="contact-icon">
        <i class="fa-solid fa-location-dot fa-icon"></i>
      </div>
      <div class="contact-info">
        <h3>Visit us</h3>
        <p>{address}</p>
      </div>
    </div>
    <div class="footer-contact-card">
      <div class="contact-icon">
        <i class="fa-solid fa-clock fa-icon"></i>
      </div>
      <div class="contact-info">
        <h3>Hourlies</h3>
        <p>{hourlies}</p>
      </div>
    </div>
  </section>
  <section class="footer-social-section">
    <div class="footer-social-icons fade-up">
      <a
        href={facebook}
        class="social-icon-link"
        target="_blank"
        rel="nooppener noreferrer"
        title={`Go to ${name}'s Facebook`}
      >
        <i class="fa-brands fa-facebook-f"></i>
      </a>
      <a
        href={instagram}
        class="social-icon-link"
        target="_blank"
        rel="nooppener noreferrer"
        title={`Go to ${name}'s Instagram`}
      >
        <i class="fa-brands fa-instagram"></i>
      </a>
      <a
        href={youtube}
        class="social-icon-link"
        target="_blank"
        rel="nooppener noreferrer"
        title={`Go to ${name}'s YouTube`}
      >
        <i class="fa-brands fa-youtube"></i>
      </a>
    </div>
  </section>
  <section class="footer-dev-section">
    <p class="dev-signature">
      Developed by 
      <a
        href="https://github.com/MartinXCVI/"
        target="_blank"
        rel="noreferrer noopener"
        title="Go to author's GitHub profile"
      >
        MartinXCVI <i class="fa-brands fa-github"></i>
      </a>
    </p>
  </section>
</footer>