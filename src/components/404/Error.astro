<section class="error-wrapper over-x">
  <div class="error-title-div">
    <h1 class="error-title slide-left-to-right">
      Oops!
    </h1>
    <figure class="error-fig slide-right-to-left">
      <img
        src="/icons/broken-egg.png"
        alt=""
        title=""
      >
    </figure>
  </div>
  
  <p class="error-text slide-right-to-left">Something went wrong...</p>
  <p class="error-text slide-left-to-right">Or the resource that you are looking for does not exist.</p>
  <p class="error-link">
    <a
      href="/"
      rel="noreferrer noopener"
      title="Back to website button"
      aria-label="Back to website button"
    >
      Get back to the site
    </a>
  </p>
</section>